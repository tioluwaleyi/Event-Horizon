# ==============================
# Event Horizon - Git Ignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw research data
data/raw/**/*.json
data/raw/**/*.csv
data/raw/**/*.parquet

# Large/intermediate processed data
data/processed/*.json
data/processed/*.csv
data/processed/*.parquet

# Collection checkpoints
*checkpoint*.json

# Logs / temporary files
*.log
*.tmp

# Jupyter
.ipynb_checkpoints/process.txt
process.txt
